# ==============================================================================
# Kura - Environment Configuration Example (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# サーバー & インフラ設定
# ------------------------------------------------------------------------------
PORT=8080
AWS_REGION=ap-northeast-1

# DynamoDB 接続設定 (ローカル開発環境では dynamodb:8000 を指定)
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE_NAME=KuraUsage

# 管理者用 API キー (Admin API 認証用)
ADMIN_API_KEY=sk-admin-master-key

# 月次トークン上限デフォルト値 (初期チーム用)
DEFAULT_TOKEN_QUOTA=1000000

# レート制限 (RPM: Requests Per Minute、0で無制限)
RATE_LIMIT_RPM=600

# 定期バッチジョブの自動実行 (月次レポート・予算アラート)
ENABLE_INTERNAL_CRON=true

# Scalar API ドキュメント UI パス (空文字または off/none で無効化)
DOCS_PATH=/docs

# OpenAPI 3.1 仕様書エンドポイント パス (空文字または off/none で無効化)
OPENAPI_PATH=/openapi

# ------------------------------------------------------------------------------
# 各 LLM プロバイダ設定
# ※ 使用しないプロバイダは空文字のままでOK（自動的に無効化されます）
# ※ ローカル検証用モックサーバーを使う場合:
#    MICROSOFT_FOUNDRY_ENDPOINT=http://mock-llm:8090
#    MICROSOFT_FOUNDRY_API_KEY=mock-key
#    GEMINI_BASE_URL=http://mock-llm:8090
#    GEMINI_API_KEY=mock-key
# ------------------------------------------------------------------------------

# --- Microsoft Foundry ---
# グローバルエンドポイント (例: https://your-resource.openai.azure.com/openai/v1)
MICROSOFT_FOUNDRY_ENDPOINT=
# 日本国内限定エンドポイント (X-Data-Residency: japan 指定時に使用、例: Japan East)
MICROSOFT_FOUNDRY_ENDPOINT_JAPAN=
# Foundry API キー
MICROSOFT_FOUNDRY_API_KEY=
# API バージョン
MICROSOFT_FOUNDRY_API_VERSION=2024-02-15-preview
# 未指定時のデフォルトデプロイメント名 (例: gpt-5.4-mini)
MICROSOFT_FOUNDRY_DEFAULT_DEPLOYMENT=

# --- Google Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

